classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() list
    }
    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task)
    }
    class Task {
        +str description
        +date due_date
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
    }
    class Scheduler {
        +Owner owner
        +sort_by_time(day) list
        +filter_tasks(pet_name, completed, day) list
        +detect_conflicts(day) list
    }
    Owner "1" *-- "0..*" Pet : cares for
    Pet "1" *-- "0..*" Task : owns occurrences
    Scheduler --> Owner : reads all pets tasks
